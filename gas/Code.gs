/**
 * Class Heroes - Google Apps Script backend
 *
 * Setup: paste this whole file into your Google Sheet under Extensions → Apps Script,
 * then Deploy → New deployment → Web app (Execute as: Me; Who has access: Anyone).
 *
 * Sheets (created automatically the first time):
 *   teachers         Teacher accounts (passwords are stored only as salted hashes)
 *   data             Each teacher's full data (JSON, split across columns if too long)
 *   Points overview  Points per student and activity, easy to read in the sheet (refreshed on every save)
 *   classes          Mapping between classes and their tabs (used by the program)
 *   Each class gets two tabs: "<class>" for points and "<class> · Reading" for the reading log.
 *   They are created on the first save after a class is added, and renamed or deleted with the class.
 *   These tabs are generated by the program and are for viewing only. Manual edits are
 *   overwritten the next time data is saved.
 */

/* ====================================================================
 * >>> CHANGE THESE TO YOUR OWN LANGUAGE <<<
 *
 * The tab names and column headers in LABELS below are in English by default.
 * Please change the text in quotes to the language you want your sheet to use.
 * The comment after each line has Chinese (华文), Malay (Melayu) and Tamil (தமிழ்)
 * suggestions you can copy.
 *
 * After changing them:
 *   1. Press Ctrl+S (Cmd+S on Mac) to save.
 *   2. Redeploy: Deploy → Manage deployments → Edit (pencil) → Version: New version → Deploy.
 * Tabs with the old names are renamed automatically the next time data is saved.
 * No data is lost.
 * ==================================================================== */
const LABELS = {
  /* Points overview tab */
  viewSheet: 'Points overview',          /* 华文 '积分总览' · Melayu 'Ringkasan mata' · தமிழ் 'புள்ளி மேலோட்டம்' */
  viewHeader: [
    'Teacher',                           /* 华文 '教师' · Melayu 'Guru' · தமிழ் 'ஆசிரியர்' */
    'Class',                             /* 华文 '班级' · Melayu 'Kelas' · தமிழ் 'வகுப்பு' */
    'Student',                           /* 华文 '学生' · Melayu 'Murid' · தமிழ் 'மாணவர்' */
    'Activity',                          /* 华文 '活动' · Melayu 'Aktiviti' · தமிழ் 'செயல்பாடு' */
    'Count',                             /* 华文 '次数' · Melayu 'Kiraan' · தமிழ் 'எண்ணிக்கை' */
    'Points',                            /* 华文 '分数' · Melayu 'Mata' · தமிழ் 'புள்ளிகள்' */
    'Student total'                      /* 华文 '学生总分' · Melayu 'Jumlah murid' · தமிழ் 'மாணவர் மொத்தம்' */
  ],

  /* Points tab of each class */
  student: 'Student',                    /* 华文 '学生' · Melayu 'Murid' · தமிழ் 'மாணவர்' */
  total: 'Total',                        /* 华文 '总分' · Melayu 'Jumlah' · தமிழ் 'மொத்தம்' */
  /* Header of each activity column, e.g. "Spelling (10 pts each)" */
  activityHeader: function (name, pts) { return name + ' (' + pts + ' pts each)'; },
                                         /* 华文 name + '（' + pts + '分/次）' · Melayu name + ' (' + pts + ' mata)' · தமிழ் name + ' (' + pts + ' புள்ளிகள்)' */

  /* Reading tab of each class */
  readingSuffix: ' · Reading',           /* 华文 '·阅读' · Melayu ' · Bacaan' · தமிழ் ' · வாசிப்பு'  (tab name = class name + this) */
  readingHeader: [
    'Student',                           /* 华文 '学生' · Melayu 'Murid' · தமிழ் 'மாணவர்' */
    'Current progress (0-9)',            /* 华文 '当前进度（0-9）' · Melayu 'Kemajuan semasa (0-9)' · தமிழ் 'தற்போதைய முன்னேற்றம் (0-9)' */
    'Rounds completed',                  /* 华文 '完成轮数' · Melayu 'Pusingan selesai' · தமிழ் 'முடித்த சுற்றுகள்' */
    'Books read',                        /* 华文 '总阅读量（本）' · Melayu 'Jumlah buku' · தமிழ் 'வாசித்த புத்தகங்கள்' */
    'Last check-in'                      /* 华文 '最近打卡' · Melayu 'Rekod terakhir' · தமிழ் 'கடைசிப் பதிவு' */
  ],

  /* Tab name used when a class has no name */
  defaultClass: 'Class'                  /* 华文 '班级' · Melayu 'Kelas' · தமிழ் 'வகுப்பு' */
};

/* Internal tabs used by the program. Please do not rename these. */
const SHEET_TEACHERS = 'teachers';
const SHEET_DATA = 'data';
const SHEET_CLASSES = 'classes';
const SHEET_VIEW = LABELS.viewSheet;
const OLD_VIEW_NAMES = ['积分总览', 'Points overview']; // earlier names of the overview tab; renamed automatically
const RESERVED = [SHEET_TEACHERS, SHEET_DATA, SHEET_VIEW, SHEET_CLASSES];
const CHUNK = 40000; // a cell holds up to 50000 characters; leave some margin

function doGet() {
  return out({ ok: true, app: 'ClassHero' });
}

function doPost(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const req = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    const handlers = { register: register, login: login, load: load, save: save };
    const fn = handlers[req.action];
    if (!fn) return out({ ok: false, error: 'unknown_action' });
    return out(fn(req));
  } catch (err) {
    return out({ ok: false, error: String(err) });
  } finally {
    lock.releaseLock();
  }
}

function out(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}

function getSheet(name, header, allText) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let s = ss.getSheetByName(name);
  if (!s) {
    s = ss.insertSheet(name);
    if (allText !== false) s.getRange(1, 1, s.getMaxRows(), s.getMaxColumns()).setNumberFormat('@');
    s.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    s.setFrozenRows(1);
  }
  return s;
}

function teachersSheet() {
  return getSheet(SHEET_TEACHERS, ['id', 'username', 'name', 'salt', 'passwordHash', 'token', 'createdAt']);
}

function dataSheet() {
  return getSheet(SHEET_DATA, ['teacherId', 'updatedAt', 'json']);
}

function hash(salt, pw) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, salt + pw, Utilities.Charset.UTF_8)
    .map(function (b) { return ((b + 256) % 256).toString(16); })
    .map(function (h) { return h.length < 2 ? '0' + h : h; })
    .join('');
}

function findRow(sheet, col, val) {
  const v = sheet.getDataRange().getValues();
  for (let i = 1; i < v.length; i++) {
    if (String(v[i][col]) === String(val)) return { row: i + 1, values: v[i] };
  }
  return null;
}

function publicUser(v) {
  return { id: String(v[0]), username: String(v[1]), name: String(v[2]) };
}

function register(r) {
  const u = String(r.username || '').trim();
  const p = String(r.password || '');
  const n = String(r.name || '').trim();
  if (!u || !p || !n) return { ok: false, error: 'missing_fields' };
  const s = teachersSheet();
  if (findRow(s, 1, u)) return { ok: false, error: 'username_taken' };
  const id = Utilities.getUuid(), salt = Utilities.getUuid(), token = Utilities.getUuid();
  const row = [id, u, n, salt, hash(salt, p), token, new Date().toISOString()];
  s.getRange(s.getLastRow() + 1, 1, 1, row.length).setNumberFormat('@').setValues([row]);
  return { ok: true, token: token, user: publicUser(row) };
}

function login(r) {
  const f = findRow(teachersSheet(), 1, String(r.username || '').trim());
  if (!f || hash(f.values[3], String(r.password || '')) !== String(f.values[4])) {
    return { ok: false, error: 'bad_login' };
  }
  return { ok: true, token: String(f.values[5]), user: publicUser(f.values) };
}

function auth(token) {
  if (!token) return null;
  const f = findRow(teachersSheet(), 5, token);
  return f ? publicUser(f.values) : null;
}

function load(r) {
  const user = auth(r.token);
  if (!user) return { ok: false, error: 'bad_token' };
  const f = findRow(dataSheet(), 0, user.id);
  if (!f) return { ok: true, data: null };
  const json = f.values.slice(2).join('');
  return { ok: true, data: json ? JSON.parse(json) : null, updatedAt: String(f.values[1]) };
}

function save(r) {
  const user = auth(r.token);
  if (!user) return { ok: false, error: 'bad_token' };
  if (!r.data || !Array.isArray(r.data.classes)) return { ok: false, error: 'bad_data' };
  const json = JSON.stringify(r.data);
  const chunks = [];
  for (let i = 0; i < json.length; i += CHUNK) chunks.push(json.slice(i, i + CHUNK));
  const now = new Date().toISOString();
  const row = [user.id, now].concat(chunks);

  const s = dataSheet();
  const f = findRow(s, 0, user.id);
  const rowNum = f ? f.row : s.getLastRow() + 1;
  const lastCol = Math.max(s.getLastColumn(), row.length);
  if (f) s.getRange(rowNum, 1, 1, lastCol).clearContent();
  s.getRange(rowNum, 1, 1, row.length).setNumberFormat('@').setValues([row]);

  updateView(user, r.data);
  syncClassTabs(user, r.data);
  return { ok: true, updatedAt: now };
}

/** Refresh this teacher's rows in the points overview: teacher / class / student / activity / count / points / student total */
function updateView(user, data) {
  const header = LABELS.viewHeader;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss.getSheetByName(SHEET_VIEW)) {
    const old = OLD_VIEW_NAMES.map(function (n) { return ss.getSheetByName(n); }).filter(Boolean)[0];
    if (old) old.setName(SHEET_VIEW);
  }
  const s = getSheet(SHEET_VIEW, header, false);
  s.getRange(1, 1, 1, s.getMaxColumns()).clearContent();
  s.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
  const all = s.getDataRange().getValues();
  const keep = all.slice(1).filter(function (row) { return String(row[0]) !== user.username; });
  const mine = [];
  (data.classes || []).forEach(function (c) {
    const acts = c.activities || [];
    (c.students || []).forEach(function (st) {
      const counts = st.activityCounts || {};
      const total = acts.reduce(function (t, a) { return t + (counts[a.id] || 0) * a.pointValue; }, 0);
      acts.forEach(function (a) {
        const n = counts[a.id] || 0;
        mine.push([user.username, c.name, st.name, a.name, n, n * a.pointValue, total]);
      });
    });
  });
  const rows = keep.concat(mine).map(function (r) { return r.slice(0, header.length); });
  if (s.getLastRow() > 1) s.getRange(2, 1, s.getLastRow() - 1, header.length).clearContent();
  if (rows.length) {
    const range = s.getRange(2, 1, rows.length, header.length);
    s.getRange(2, 1, rows.length, 4).setNumberFormat('@');
    range.setValues(rows);
  }
}

function classesSheet() {
  return getSheet(SHEET_CLASSES, ['teacherId', 'classId', 'sheetId', 'className', 'readingSheetId']);
}

function cleanName(name) {
  const n = String(name || '').replace(/[:\\\/?*\[\]]/g, '').trim().slice(0, 80);
  return n || LABELS.defaultClass;
}

/** Pick a unique tab name for a class: 4A → 4A (Mr Tan) → 4A (Mr Tan)2 … */
function uniqueTabName(ss, name, user, self) {
  const base = cleanName(name);
  const free = function (n) {
    if (RESERVED.indexOf(n) >= 0) return false;
    const s = ss.getSheetByName(n);
    return !s || (self && s.getSheetId() === self.getSheetId());
  };
  if (free(base)) return base;
  const withName = base + ' (' + user.name + ')';
  if (free(withName)) return withName;
  for (let i = 2; ; i++) if (free(withName + i)) return withName + i;
}

/** One set of tabs per class; created, renamed and deleted along with the class */
function syncClassTabs(user, data) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const reg = classesSheet();
  const rows = reg.getDataRange().getValues().slice(1).filter(function (r) { return r[0] !== ''; });
  const others = rows.filter(function (r) { return String(r[0]) !== user.id; });
  const mine = {};
  rows.forEach(function (r) {
    if (String(r[0]) === user.id) mine[String(r[1])] = { sheetId: Number(r[2]), name: String(r[3]), readingId: r[4] === '' ? -1 : Number(r[4]) };
  });
  const byId = {};
  ss.getSheets().forEach(function (s) { byId[s.getSheetId()] = s; });

  const next = {};
  (data.classes || []).forEach(function (c) {
    const old = mine[c.id];
    let sh = old && byId[old.sheetId];
    if (!sh) {
      sh = ss.insertSheet(uniqueTabName(ss, c.name, user, null));
    } else if (old.name !== c.name) {
      sh.setName(uniqueTabName(ss, c.name, user, sh));
    }
    writeClassTab(sh, c);
    let rs = old && byId[old.readingId];
    if (!rs) {
      rs = ss.insertSheet(uniqueTabName(ss, c.name + LABELS.readingSuffix, user, null));
    } else if (old.name !== c.name || rs.getName() !== uniqueTabName(ss, c.name + LABELS.readingSuffix, user, rs)) {
      // follow class renames and changes to LABELS.readingSuffix
      rs.setName(uniqueTabName(ss, c.name + LABELS.readingSuffix, user, rs));
    }
    writeReadingTab(rs, c);
    next[c.id] = { sheetId: sh.getSheetId(), name: c.name, readingId: rs.getSheetId() };
  });

  Object.keys(mine).forEach(function (cid) {
    if (next[cid]) return;
    if (byId[mine[cid].sheetId]) ss.deleteSheet(byId[mine[cid].sheetId]);
    if (byId[mine[cid].readingId]) ss.deleteSheet(byId[mine[cid].readingId]);
  });

  const all = others.map(function (r) { return r.slice(0, 5); }).concat(Object.keys(next).map(function (cid) {
    return [user.id, cid, String(next[cid].sheetId), next[cid].name, String(next[cid].readingId)];
  }));
  if (reg.getLastRow() > 1) reg.getRange(2, 1, reg.getLastRow() - 1, 5).clearContent();
  if (all.length) reg.getRange(2, 1, all.length, 5).setNumberFormat('@').setValues(all);
}

/** Points tab: student | count per activity | total */
function writeClassTab(sh, c) {
  const acts = c.activities || [];
  const header = [LABELS.student].concat(acts.map(function (a) { return LABELS.activityHeader(a.name, a.pointValue); }), [LABELS.total]);
  const rows = (c.students || []).map(function (st) {
    const counts = st.activityCounts || {};
    const n = acts.map(function (a) { return counts[a.id] || 0; });
    const total = acts.reduce(function (t, a, i) { return t + n[i] * a.pointValue; }, 0);
    return [st.name].concat(n, [total]);
  });
  sh.clearContents();
  const all = [header].concat(rows);
  sh.getRange(1, 1, all.length, 1).setNumberFormat('@');
  sh.getRange(1, 1, all.length, header.length).setValues(all);
  sh.getRange(1, 1, 1, header.length).setFontWeight('bold');
  sh.setFrozenRows(1);
}

/** Reading tab: student | current progress | rounds completed | books read | last check-in (separate from points) */
function writeReadingTab(sh, c) {
  const header = LABELS.readingHeader;
  const rows = (c.students || []).map(function (st) {
    const r = st.reading || { progress: 0, rounds: 0, log: [] };
    const log = r.log || [];
    const last = log.length ? log[log.length - 1].date : '';
    return [st.name, r.progress || 0, r.rounds || 0, (r.rounds || 0) * 10 + (r.progress || 0), last];
  });
  sh.clearContents();
  const all = [header].concat(rows);
  sh.getRange(1, 1, all.length, 1).setNumberFormat('@');
  sh.getRange(1, 5, all.length, 1).setNumberFormat('@');
  sh.getRange(1, 1, all.length, header.length).setValues(all);
  sh.getRange(1, 1, 1, header.length).setFontWeight('bold');
  sh.setFrozenRows(1);
}
